    "test:e2e": "playwright test",
    "validate:data": "node data/validate-data.mjs"
  },
  "dependencies": {
    "lucide-react": ">=1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": ">=6.6.0",
    "@testing-library/react": ">=16.1.0",
    "@types/node": ">=22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": ">=25.0.0",
    "modern-web-guidance": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
