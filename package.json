{
  "name": "zelda-oot-switch2-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "The Legend of Zelda: Ocarina of Time (Nintendo Switch 2 Remake, 2026) Interactive Map & Secrets Guide PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
